{
  "name": "dataverse-schema",
  "version": "1.1.5",
  "description": "A Schema library designed for Microsoft Dataverse to aid in Web API calls",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/dataverse-schema.mjs",
  "module": "dist/dataverse-schema.mjs",
  "typings": "dist/dataverse-schema.d.ts",
  "exports": {
    ".": {
      "import": "./dist/dataverse-schema.mjs",
      "types": "./dist/dataverse-schema.d.ts"
    },
    "./tanstack": {
      "import": "./dist/tanstack.mjs",
      "types": "./dist/tanstack.d.ts"
    },
    "./tanstack-db": {
      "import": "./dist/tanstack-db.mjs",
      "types": "./dist/tanstack-db.d.ts"
    }
  },
  "keywords": [
    "dataverse",
    "webresource",
    "schema",
    "dynamics",
    "crm",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielrkling/dataverse-schema.git"
  },
  "author": "LeviEyal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danielrkling/dataverse-schema/issues"
  },
  "homepage": "https://github.com/danielrkling/dataverse-schema#readme",
  "devDependencies": {
    "@tanstack/db": "^0.6.16",
    "@vitest/coverage-v8": "^3.2.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "msw": "^2.14.6",
    "vite": "^6.2.6",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "idb": "^8.0.3",
    "valibot": "^1.4.2"
  },
  "peerDependencies": {
    "@tanstack/db": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/db": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build && vite build --mode tanstack && vite build --mode tanstack-db",
    "dev": "vite"
  }
}
