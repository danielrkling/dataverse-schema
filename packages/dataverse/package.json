{
  "name": "dataverse-schema",
  "version": "2.1.0",
  "description": "A Schema library designed for Microsoft Dataverse to aid in Web API calls",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./provision": {
      "types": "./dist/provision/index.d.ts",
      "import": "./dist/provision/index.js",
      "default": "./dist/provision/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js",
      "default": "./dist/sync/index.js"
    },
    "./sync/tanstack": {
      "types": "./dist/sync/tanstack.d.ts",
      "import": "./dist/sync/tanstack.js",
      "default": "./dist/sync/tanstack.js"
    }
  },
  "keywords": [
    "dataverse",
    "webresource",
    "schema",
    "dynamics",
    "crm",
    "api",
    "provisioning",
    "metadata"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielrkling/dataverse-schema.git",
    "directory": "packages/dataverse"
  },
  "author": "LeviEyal",
  "license": "MIT",
  "homepage": "https://github.com/danielrkling/dataverse-schema/tree/main/packages/dataverse#readme",
  "bugs": {
    "url": "https://github.com/danielrkling/dataverse-schema/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "dev": "vite",
    "build:browser-test": "vite build --mode browser-test && vite build --mode browser-db-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck --typecheck.include=\"test/*typecheck*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@tanstack/db": "^0.8.7"
  },
  "peerDependenciesMeta": {
    "@tanstack/db": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/db": "^0.8.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "msw": "^2.14.6",
    "tsdown": "^0.22.14",
    "valibot": "^1.4.2",
    "vite": "^6.2.6",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.1"
  }
}
