{
  "name": "sharepoint-schema",
  "version": "0.1.0",
  "description": "A Schema library designed for Microsoft SharePoint (legacy _api/web REST, OData v3) to aid in Web API calls for lists and libraries",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "sharepoint",
    "spfx",
    "schema",
    "rest",
    "api",
    "lists"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielrkling/dataverse-schema.git",
    "directory": "packages/sharepoint"
  },
  "author": "LeviEyal",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "vitest": "^3.1.1"
  }
}
